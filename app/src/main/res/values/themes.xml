<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TestApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Surfaces and text. -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Shared pill-shaped button look, used across every screen for visual consistency. -->
    <style name="Widget.App.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/round_corners</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Outline-only variant: transparent fill, white border. -->
    <style name="Widget.App.Button.Outline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/round_corners_outline</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_on_dark_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Blue, rounded-rectangle button used by the workshop exercise screens. -->
    <style name="Widget.App.Button.Workshop" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/workshop_button</item>
        <item name="android:backgroundTint">@null</item>
        <!-- MaterialButton tints via app:backgroundTint, so clear it too to keep the drawable's own color -->
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
