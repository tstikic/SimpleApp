<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workshop_welcome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".WorkshopWelcomeActivity">

    <ScrollView
        android:id="@+id/workshop_welcome_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/workshop_welcome_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/workshop_welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/workshop_welcome_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- ViewPager2 (Carousel) -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/workshop_carousel"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal" />

            <!-- Page indicator dots -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/workshop_dot_1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/workshop_dot_selected" />

                <View
                    android:id="@+id/workshop_dot_2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/workshop_dot_unselected" />

                <View
                    android:id="@+id/workshop_dot_3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/workshop_dot_unselected" />
            </LinearLayout>

            <TextView
                android:id="@+id/workshop_swipe_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_workshop_swipe"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:text="@string/workshop_swipe_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider" />

            <!-- About the Workshop Section -->
            <TextView
                android:id="@+id/workshop_about_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/workshop_about_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/workshop_about_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workshop_about_body"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <!-- Scroll hint -->
            <TextView
                android:id="@+id/workshop_scroll_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:drawableTop="@drawable/ic_workshop_arrow_down"
                android:drawablePadding="8dp"
                android:gravity="center_horizontal"
                android:text="@string/workshop_scroll_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="24dp"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/workshop_practice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="@string/workshop_practice_body"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/workshop_ready_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workshop_ready_body"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <!-- Button at the bottom (Requires scrolling) -->
            <Button
                android:id="@+id/get_started_button"
                style="@style/Widget.App.Button.Workshop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="64dp"
                android:text="@string/workshop_get_started_btn_text" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
