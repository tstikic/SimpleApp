<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:orientation="vertical">

    <include layout="@layout/app_header" />

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero image, takes most of the screen -->
        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/qa_bugs" />

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/welcome_qa_family"
            android:textAlignment="center"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Learning intro subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_learning_subtitle"
            android:textAlignment="center"
            android:textColor="@color/text_on_dark_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/go_to_recycler_view_button"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/scrollable_screen_btn_text" />
    </LinearLayout>
</LinearLayout>
