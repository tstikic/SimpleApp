<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_overlay"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Main item text -->
        <TextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item Name"
            android:textColor="@color/text_on_dark_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <android.widget.Button
            android:id="@+id/upload_document_btn"
            style="@style/Widget.App.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Add data"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Expanded subtitle, initially hidden -->
    <TextView
        android:id="@+id/item_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="QA member"
        android:textColor="@color/text_on_dark_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
